# Copy to .env (read by docker-compose.yml) and adjust. Every value has a safe default.

# ---------- Security ----------
# Admin key (>= 16 chars). Leave empty to generate one on first boot: it is printed once
# in the log and saved to /app/data/.api-key inside the app container.
ADMIN_API_KEY=
# false = legacy open API (no key needed). Only for a gradual migration.
AUTH_REQUIRED=true
# Comma separated origins allowed by CORS (* = any).
CORS_ORIGINS=*
# Optional IP allowlist for /api, /ws and /metrics (e.g. 10.0.0.0/8,192.168.1.10).
ALLOWED_CIDRS=
# Requests per minute per credential (or per IP without credential). 0 disables it.
RATE_LIMIT_PER_MINUTE=600
# Bearer token for Prometheus scraping of /metrics (admin keys also work).
METRICS_TOKEN=

# ---------- Infrastructure passwords ----------
POSTGRES_PASSWORD=securepassword
RABBITMQ_PASSWORD=securepassword
REDIS_PASSWORD=
MINIO_ROOT_USER=whatsmeowAdmin
MINIO_ROOT_PASSWORD=securepassword
MINIO_BUCKET=whatsmeow-media
# Public address used in presigned media links (e.g. https://media.example.com).
MINIO_PUBLIC_URL=

# ---------- Webhooks ----------
# Global fallback for instances without their own webhook_url.
WEBHOOK_URL=
# HMAC-SHA256 secret: X-Webhook-Signature = "sha256=" + hex(HMAC(secret, X-Webhook-Timestamp + "." + body)).
WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_SECONDS=15
WEBHOOK_WORKERS=8
# Delivered rows are purged after N days (failed rows after 30 days).
WEBHOOK_RETENTION_DAYS=7

# ---------- Messaging ----------
MESSAGE_WORKERS=4
MESSAGE_MAX_ATTEMPTS=5
# 0 keeps the message history forever.
MESSAGE_RETENTION_DAYS=0
# Download incoming media to MinIO (enables /api/message/download links).
MEDIA_ARCHIVE_ENABLED=false
MEDIA_MAX_MB=64
# Show "typing..." before text messages (proportional to the text length).
SIMULATE_TYPING=false

# Anti-ban send pacing (off by default).
SEND_PACING_ENABLED=false
# Daily cap by session age in days: day 0, day 1, ... and the last value afterwards.
SEND_PACING_WARMUP_SCHEDULE=50,100,200,400,800,1500
# Max first-contact conversations per day.
SEND_PACING_COLD_DAILY_CAP=50
# Consecutive failures that pause sending for 30 minutes.
SEND_PACING_FAILURE_BREAKER=10

# ---------- Logging ----------
LOG_LEVEL=info
WA_LOG_LEVEL=INFO
# Dump outgoing protobufs (very verbose).
DEBUG_MESSAGES=false
